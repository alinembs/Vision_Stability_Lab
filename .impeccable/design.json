    }
  },
  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-default",
      "description": "Botão de ação: fundo verde de ação, texto on-action, raio 8px.",
      "html": "<button class=\"btn\">Conectar</button>",
      "css": ".btn { padding: 6px 12px; border: 1px solid var(--accent); border-radius: 8px; background: var(--accent); color: var(--on-accent); font-size: 12px; font-weight: 500; } .btn:hover { background: var(--accent-hover); border-color: var(--accent-hover); } .btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; } .btn[disabled] { background: var(--panel-2); border-color: var(--line); color: var(--faint); cursor: not-allowed; }"
    },
    {
      "name": "Filter Chip",
      "kind": "chip",
      "refersTo": "chip-default",
      "description": "Pílula de filtro: hairline; ativa em lavagem e borda de ação, com aria-pressed.",
      "html": "<div class=\"event-filter\"><button class=\"chip active\" aria-pressed=\"true\">tudo</button><button class=\"chip\" aria-pressed=\"false\">tracks</button><button class=\"chip\" aria-pressed=\"false\">erros</button></div>",
      "css": ".chip { padding: 3px 9px; border: 1px solid var(--line); border-radius: 999px; background: transparent; color: var(--dim); font-size: 10px; font-weight: 500; } .chip:hover { color: var(--text); border-color: var(--dim); } .chip.active { background: var(--accent-soft); border-color: var(--accent-dim); color: var(--accent); }"
    },
    {
      "name": "Source Card",
      "kind": "card",
      "refersTo": "source-card",
      "description": "Cartão compacto da sidebar: o cartão é o alvo de ver; ativar é botão irmão.",
      "html": "<article class=\"source-card selected is-active\"><button class=\"source-view\"><span class=\"source-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><rect x=\"2\" y=\"6\" width=\"14\" height=\"12\" rx=\"1.5\"/><path d=\"M16 10.5 22 7v10l-6-3.5z\"/></svg></span><span class=\"source-body\"><span class=\"source-line\"><span class=\"source-name\">câmera fixa</span><span class=\"source-badge\">ativa</span></span><span class=\"source-id\">camera · h265</span><span class=\"source-path\">RTSP_URI (deploy/.env)</span><span class=\"source-meta\">há 2.3h · 42 amostras</span></span></button></article>",
      "css": ".source-card { display: grid; grid-template-columns: minmax(0,1fr) auto; gap: 6px; padding: 8px; background: var(--panel); border: 1px solid var(--line); border-radius: 10px; } .source-card:hover { background: var(--panel-2); } .source-card.selected { background: var(--accent-soft); border-color: var(--accent-dim); } .source-view { display: flex; gap: 8px; min-width: 0; padding: 0; border: 0; background: none; color: inherit; text-align: left; } .source-icon { width: 22px; height: 22px; color: var(--dim); } .source-card.selected .source-icon { color: var(--accent); } .source-name { font-size: 12px; font-weight: 600; } .source-badge { padding: 1px 6px; border-radius: 999px; background: var(--accent); color: var(--on-accent); font-size: 9px; } .source-id, .source-meta { font-family: var(--mono); font-size: 9px; color: var(--faint); } .source-path { font-family: var(--mono); font-size: 10px; color: var(--dim); }"
    },
    {
      "name": "Stat Card",
      "kind": "card",
      "refersTo": "stat-card",
      "description": "Resumo de dez segundos: rótulo de 10px, valor de 30px tabular, dica de 11px.",
      "html": "<article class=\"card stat\"><h3 class=\"stat-label\">fps processado</h3><output class=\"stat-value\">19.8</output><div class=\"stat-hint\">preview <output>19.9</output> · drop <output>0.04</output></div></article>",
      "css": ".stat { gap: 2px; padding: 12px 14px; } .stat-label { font-size: 10px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; color: var(--dim); } .stat-value { font-family: var(--condensed); font-size: 30px; font-weight: 600; line-height: 1.1; font-variant-numeric: tabular-nums; } .stat-hint { font-size: 11px; color: var(--dim); } .stat-hint output { font-family: var(--mono); font-size: 10px; color: var(--text); }"
    },
    {
      "name": "Sheet Panel",
      "kind": "card",
      "refersTo": "sheet",
      "description": "Folha de caderno: raio 12px, hairline, sombra curta no claro e nenhuma no escuro.",
      "html": "<section class=\"card\"><div class=\"panel-head\"><span class=\"eyebrow\">saúde do sistema</span></div><div class=\"state-rows\"><div class=\"row\"><span>status geral</span><output class=\"ok\">healthy</output></div><div class=\"row\"><span>threads / fds</span><output>18 / 42</output></div></div></section>",
      "css": ".card { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; box-shadow: var(--shadow); display: flex; flex-direction: column; padding: 14px 16px; } .panel-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 0 0 10px; } .eyebrow { font-size: 10px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; color: var(--dim); } .row { display: flex; justify-content: space-between; padding: 7px 0; border-top: 1px solid var(--divider); } .row:first-child { border-top: 0; } .row span { font-size: 12px; color: var(--dim); } .row output { font-family: var(--mono); font-size: 11px; } .ok { color: var(--ok); }"
    },
    {
      "name": "Lamp",
      "kind": "custom",
      "description": "Lâmpada de 9px com anel de 3px na cor do estado; blink só sob estado vivo.",
      "html": "<div class=\"lamps\"><div class=\"lamp\"><span class=\"bulb on\"></span><span class=\"tag\">pipeline</span></div><div class=\"lamp\"><span class=\"bulb warn\"></span><span class=\"tag\">memória</span></div><div class=\"lamp\"><span class=\"bulb off blink\"></span><span class=\"tag\">telemetria</span></div></div>",
      "css": ".lamps { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 10px; } .lamp { display: flex; align-items: center; gap: 7px; } .lamp .tag { font-size: 10px; color: var(--dim); } .bulb { width: 9px; height: 9px; border-radius: 50%; background: var(--lamp-rest-bg); border: 1px solid var(--lamp-rest-border); } .bulb.on { background: var(--accent); border-color: var(--lamp-on-border); box-shadow: 0 0 0 3px var(--accent-soft); } .bulb.warn { background: var(--warn); border-color: var(--warn); box-shadow: 0 0 0 3px var(--warn-soft); } .bulb.off { background: var(--bad); border-color: var(--lamp-fail-border); box-shadow: 0 0 0 3px var(--bad-soft); }"
    }
  ],
